# Copy to .env on the server. Never commit .env.
POSTGRES_PASSWORD=change-me
DASHBOARD_PASSWORD=change-me
# A domain pointing at the server, or <server-ip>.sslip.io (free, gives HTTPS without a domain)
SITE_ADDRESS=203.0.113.10.sslip.io
# To use Supabase instead of the local database, set DATABASE_URL in the supervisor and
# dashboard services to your Supabase connection string and remove the db service.
